# Names only — real values live in Secret Manager or an untracked
# .env.local, never here and never committed (CLAUDE.md §7).

GOOGLE_CLOUD_PROJECT=
APP_REGION=asia-southeast2
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
CLOUD_TASKS_QUEUE=
TASKS_INVOKER_SA=
PIPELINE_TICK_AUDIENCE=
DEMO_MODE=false
DAILY_TOKEN_CEILING=
THREAD_HANDLE_KEY=
# Optional: named Firestore database (staging). Leave empty for "(default)".
FIRESTORE_DATABASE_ID=

# R-24: the tool-using Proposal agent (v4). Exactly "true" enables it; anything else (including unset) keeps the v3
# path. "true" only on web-develop staging until Rangga's go; the demo "web" and the pilot stay unset.
PROPOSAL_AGENT_V4=false

# DebriefAgent (docs/tasks/debrief-agent-18oct.md): an agent words the debrief question heading on DEMO SANDBOX
# outlets only (outlet id prefix "sbx-"). Exactly "true" enables it; anything else (including unset) keeps the
# template heading. Never on the pilot; "true" only on web-develop until Rangga's go. The kill is removing this var,
# never a traffic rollback to an older revision (question docs carrying `agent` are skipped by older revisions).
DEBRIEF_AGENT=false

# ReviewAgent (docs/tasks/review-agent-18oct.md): an agent explains the before/after counts of a review in plain
# English, on the demo sandbox fast-forward only. Exactly "true" enables it; the plain-code card is the fallback. Never
# on the pilot; "true" only on web-develop until Rangga's go. The kill is removing this var, never a traffic rollback
# to an older revision (review docs carrying `agent` are skipped by older revisions).
REVIEW_AGENT=false

# Dev-only /capture manual control panel + event log (DEV-01). MUST be absent
# or any value other than the literal string "true" here and in every real
# build (pilot, demo, CI) — set it to "true" only in your own untracked
# .env.local, never here.
NEXT_PUBLIC_DEV_CONTROLS=false
